from snakemake.utils import min_version
import os
import re
from pathlib import Path
import pandas as pd

##### set minimum snakemake version #####
# Updated for Snakemake 9.x compatibility (executor plugins)
# Minimum version 9.0.0 required for profile-based execution
min_version("9.0.0")

##### load rules ##########
include: "rules/common.smk"

workdir: config["outdir"]

import gzip
import struct

# Samplesheet: one row per sequencing run ("unit"). Rows that share a sampleID are
# technical replicates (lanes/runs of one library) and are merged after alignment.
# read1 may be a FASTQ (read2 = mate or empty) or a BAM file (read2 empty).
units = pd.read_csv(
    config["samplesheet"],
    sep="\t",
    dtype=str,
    na_values=['', 'NA', 'na', 'N/A', 'n/a', 'NULL', 'null', 'None', 'none', '-'],
    skipinitialspace=True,
    keep_default_na=True
)
missing_cols = {"sampleID", "condition", "group", "read1", "read2"} - set(units.columns)
assert not missing_cols, f"samplesheet is missing columns: {sorted(missing_cols)}"
for col in ["sampleID", "condition", "group", "read1"]:
    units[col] = units[col].astype(str).str.strip()
units["read2"] = units["read2"].str.strip()

# Enhanced NA detection for mixed single-end/paired-end support
def is_missing_read2(read2_value):
    """Check if read2 value indicates missing/absent file"""
    if pd.isna(read2_value):
        return True
    missing_indicators = {
        '', 'na', 'n/a', 'null', 'none', '-',
        'nan', 'nil', 'empty', '0', 'false',
        'missing', 'absent', 'single', 'se'
    }
    return str(read2_value).strip().lower() in missing_indicators

def bam_info(path, max_records=1000):
    """Reference sequences (name -> length) and flags of the first records of a BAM file."""
    with gzip.open(path, "rb") as f:  # BAM is BGZF, a series of gzip members
        if f.read(4) != b"BAM\1":
            raise ValueError(f"{path} is not a BAM file")
        l_text, = struct.unpack("<i", f.read(4))
        f.read(l_text)
        n_ref, = struct.unpack("<i", f.read(4))
        refs = {}
        for _ in range(n_ref):
            l_name, = struct.unpack("<i", f.read(4))
            name = f.read(l_name)[:-1].decode()
            refs[name], = struct.unpack("<i", f.read(4))
        flags = []
        while len(flags) < max_records:
            head = f.read(4)
            if len(head) < 4:
                break
            block_size, = struct.unpack("<i", head)
            record = f.read(block_size)
            flags.append(struct.unpack("<H", record[14:16])[0])
    return refs, flags

units["is_bam"] = units["read1"].str.lower().str.endswith(".bam")
units["unit"] = units["sampleID"] + "." + (units.groupby("sampleID").cumcount() + 1).astype(str)
UNIT_ERRORS = []
BAM_REFS = {}
paired = []
for _, row in units.iterrows():
    if not row["is_bam"]:
        paired.append(not is_missing_read2(row["read2"]))
        continue
    if not is_missing_read2(row["read2"]):
        UNIT_ERRORS.append(f"Sample {row['sampleID']}: read2 must be empty when read1 is a BAM file ({row['read1']})")
    if not os.path.exists(row["read1"]):
        paired.append(False)
        continue
    refs, flags = bam_info(row["read1"])
    BAM_REFS[row["unit"]] = refs
    is_pe = any(f & 0x1 for f in flags)
    if is_pe and not (any(f & 0x40 for f in flags) and any(f & 0x80 for f in flags)):
        UNIT_ERRORS.append(f"Sample {row['sampleID']}: paired-end BAM {row['read1']} does not contain both mates")
    paired.append(is_pe)
units["is_paired"] = paired
units = units.set_index("unit")

# One row per sample (biological replicate); the runs of a sample must agree on these
sample_rows = []
for sid, g in units.groupby("sampleID", sort=False):
    for col in ("condition", "group", "is_paired"):
        if g[col].nunique() > 1:
            UNIT_ERRORS.append(f"Sample {sid}: all rows must have the same {'read layout' if col == 'is_paired' else col}")
    dedup_values = sorted({str(v).strip().lower() for v in g["dedup"].dropna()} - {""}) if "dedup" in g else []
    if len(dedup_values) > 1:
        UNIT_ERRORS.append(f"Sample {sid}: rows disagree in the dedup column ({dedup_values})")
    sample_rows.append({
        "sampleID": sid,
        "condition": g["condition"].iloc[0],
        "group": g["group"].iloc[0],
        "is_paired": bool(g["is_paired"].iloc[0]),
        "dedup": dedup_values[0] if dedup_values else "",
        "input": "BAM" if g["is_bam"].all() else ("FASTQ" if not g["is_bam"].any() else "FASTQ+BAM"),
        "units": len(g),
    })
samplesheet = pd.DataFrame(sample_rows).set_index("sampleID")
SAMPLE_UNITS = {sid: units.index[units["sampleID"] == sid].tolist() for sid in samplesheet.index}
UNIT_LIST = units.index.tolist()
FASTQ_PE_UNITS = units.index[~units["is_bam"] & units["is_paired"]].tolist()
FASTQ_SE_UNITS = units.index[~units["is_bam"] & ~units["is_paired"]].tolist()
BAM_UNITS = units.index[units["is_bam"]].tolist()

def constraint(names, empty):
    return "|".join(re.escape(n) for n in names) or empty

# optional settings (defaults keep older config files working)
config.setdefault("dedup", "controls")
config.setdefault("macs3_broad", False)
config.setdefault("macs3_broad_cutoff", 0.1)
config.setdefault("consensus_min_replicates", 2)
config.setdefault("enrichment_regions", {})
config.setdefault("normalization", "cpm")
config.setdefault("spikein_genome", "")
DEDUP_CONFIG = config["dedup"] if isinstance(config["dedup"], dict) else {"default": config["dedup"]}
DEDUP_DEFAULT = DEDUP_CONFIG.get("default", "controls")
DEDUP_CONDITIONS = {c: v for c, v in DEDUP_CONFIG.items() if c != "default"}
assert DEDUP_DEFAULT in (True, False, "controls"), 'dedup (or dedup["default"]) must be true, false or "controls"'
for c, v in DEDUP_CONDITIONS.items():
    assert isinstance(v, bool), f'dedup["{c}"] must be true or false'
    assert c in set(samplesheet["condition"]), f'dedup["{c}"]: no samples with condition "{c}" in the samplesheet'
assert int(config["consensus_min_replicates"]) >= 1, "consensus_min_replicates must be >= 1"

# validate IgG control setup if enabled
if config["igg_control"]:
    groups = samplesheet["group"].unique()
    for group in groups:
        group_samples = samplesheet[samplesheet["group"] == group]
        controls = group_samples[group_samples["condition"] == "Control"]
        experiments = group_samples[group_samples["condition"] != "Control"]

        assert len(controls) == 1, f"Group '{group}' must have exactly one Control sample when igg_control=true, found {len(controls)}"
        assert len(experiments) >= 1, f"Group '{group}' must have at least one experimental sample when igg_control=true, found {len(experiments)}"

# validate contaminant genomes screened with FastQ Screen
assert "contaminant_genomes" in config and "contaminant_subset" in config, \
    "config needs 'contaminant_genomes' and 'contaminant_subset' (these replace 'ecoli_reference'/'ecoli_bt2_idx'; see README)"
CONTAMINANTS = config["contaminant_genomes"]
assert config["normalization"] in ("cpm", "spikein"), 'normalization must be "cpm" or "spikein"'
assert not config["spikein_genome"] or config["spikein_genome"] in CONTAMINANTS, \
    f'spikein_genome "{config["spikein_genome"]}" must be one of contaminant_genomes: {list(CONTAMINANTS)}'
assert config["normalization"] == "cpm" or config["spikein_genome"], \
    'normalization "spikein" needs spikein_genome (e.g. "Ecoli", an entry of contaminant_genomes)'
SPIKEIN = bool(config["spikein_genome"])          # count spike-in fragments (reported in stats.txt)
SPIKEIN_NORM = config["normalization"] == "spikein"  # scale tracks by them
assert CONTAMINANTS, "contaminant_genomes must list at least one genome (e.g. Ecoli)"
for name, idx in CONTAMINANTS.items():
    assert name != "Host", "'Host' is reserved for the reference genome in contaminant_genomes"
    assert name.isidentifier(), f"contaminant_genomes name '{name}' must be alphanumeric/underscore only"
    assert idx, f"contaminant_genomes['{name}'] needs a Bowtie2 index prefix"

logdir = config["outdir"] + "/logs"
if not os.path.exists(logdir):
    os.makedirs(logdir)

# Sample classification for dual-rule architecture
def get_pe_samples():
    """Return list of paired-end sample IDs"""
    return samplesheet[samplesheet['is_paired']].index.tolist()

def get_se_samples():
    """Return list of single-end sample IDs"""
    return samplesheet[~samplesheet['is_paired']].index.tolist()

# Sample lists
SAMPLES = samplesheet.index.tolist()
EXPERIMENT = samplesheet[samplesheet["condition"] != "Control"].index.tolist()
CONTROL = samplesheet[samplesheet["condition"] == "Control"].index.tolist()
PE_SAMPLES = get_pe_samples()
SE_SAMPLES = get_se_samples()

# Duplicate removal per sample. Precedence: samplesheet "dedup" column (yes/no) >
# per-condition setting in config (dedup: {"BG4": true, ...}) > default
# (true = all, false = none, "controls" = IgG only)
def default_dedup(sample):
    condition = samplesheet.loc[sample, "condition"]
    if condition in DEDUP_CONDITIONS:
        return DEDUP_CONDITIONS[condition]
    if DEDUP_DEFAULT == "controls":
        return sample in CONTROL
    return bool(DEDUP_DEFAULT)

DEDUP = {}
for s in SAMPLES:
    value = samplesheet.loc[s, "dedup"]
    if value in ("", "default"):
        DEDUP[s] = default_dedup(s)
    elif value in ("yes", "true", "1"):
        DEDUP[s] = True
    elif value in ("no", "false", "0"):
        DEDUP[s] = False
    else:
        raise ValueError(f"Sample {s}: dedup column must be yes, no or empty, found '{value}'")

# MACS3 peak format (narrow by default, broad for broad marks)
MACS_SUFFIX = "_peaks.broadPeak" if config["macs3_broad"] else "_peaks.narrowPeak"
MACS_MODE = f"--broad --broad-cutoff {config['macs3_broad_cutoff']}" if config["macs3_broad"] else ""

# Consensus peaks: experimental conditions with at least two replicates
for c in samplesheet.loc[EXPERIMENT, "condition"].unique():
    assert re.fullmatch(r"[A-Za-z0-9._-]+", c), \
        f"condition '{c}' may only contain letters, digits, '.', '_' and '-' (it is used in file names)"
CONDITION_SAMPLES = {c: samplesheet.index[samplesheet["condition"] == c].tolist()
                     for c in samplesheet.loc[EXPERIMENT, "condition"].unique()}
CONSENSUS_CONDITIONS = sorted(c for c, s in CONDITION_SAMPLES.items() if len(s) >= 2)

def condition_controls(condition):
    """IgG controls of all groups that the condition's samples belong to."""
    if not config["igg_control"]:
        return []
    groups = samplesheet.loc[CONDITION_SAMPLES[condition], "group"].unique()
    return samplesheet.index[(samplesheet["condition"] == "Control") & samplesheet["group"].isin(groups)].tolist()

def consensus_threshold(condition):
    return min(int(config["consensus_min_replicates"]), len(CONDITION_SAMPLES[condition]))

def replicate_peaks(caller, condition):
    pattern = "peaks/seacr/{s}.peaks.stringent.bed" if caller == "seacr" else f"peaks/macs3/{{s}}{MACS_SUFFIX}"
    return [pattern.format(s=s) for s in CONDITION_SAMPLES[condition]]

def pooled_peaks(caller, condition):
    if caller == "seacr":
        return f"peaks/consensus/seacr/{condition}.pooled.stringent.bed"
    return f"peaks/consensus/macs3/{condition}.pooled{MACS_SUFFIX}"

CONSENSUS_FILES = expand("peaks/consensus/{caller}/{condition}.consensus.bed",
                         caller=["seacr", "macs3"], condition=CONSENSUS_CONDITIONS)

# Region sets for enrichment: TSS (from the GTF) plus user BED files (enrichment_regions)
USER_REGIONS = dict(config["enrichment_regions"] or {})
for name in USER_REGIONS:
    assert re.fullmatch(r"[A-Za-z0-9._-]+", name), \
        f"enrichment_regions name '{name}' may only contain letters, digits, '.', '_' and '-'"
    assert not (name == "TSS" and config["gtf_file"]), "the region set name 'TSS' is reserved when gtf_file is set"
REGION_FILES = ({"TSS": "annotations/tss.bed"} if config["gtf_file"] else {}) | USER_REGIONS
REGIONS = list(REGION_FILES)

def matched_control(sample):
    """IgG control of the sample's group (None for controls or groups without one)."""
    if sample in CONTROL:
        return None
    group = samplesheet.loc[sample, "group"]
    controls = [c for c in CONTROL if samplesheet.loc[c, "group"] == group]
    return controls[0] if controls else None

wildcard_constraints:
    sample="|".join(re.escape(s) for s in SAMPLES),
    unit=constraint(UNIT_LIST, "NO_UNITS"),
    condition="|".join(re.escape(c) for c in CONSENSUS_CONDITIONS) or "NO_CONSENSUS_CONDITIONS",
    caller="seacr|macs3",
    region=constraint(REGIONS, "NO_REGIONS"),

# Enhanced validation for mixed samplesheets
def validate_mixed_samplesheet():
    """Comprehensive validation for mixed SE/PE samplesheets"""
    print("🔬 Validating mixed single-end/paired-end samplesheet...")

    errors = []
    warnings = []

    errors.extend(UNIT_ERRORS)
    for unit, row in units.iterrows():
        sample_id = row["sampleID"]
        # Validate read1 (always required)
        if not os.path.exists(row['read1']):
            errors.append(f"Sample {sample_id}: Read1 file not found: {row['read1']}")

        # Validate read2 for paired-end FASTQ input
        if not row["is_bam"] and row['is_paired']:
            if pd.isna(row['read2']) or not os.path.exists(row['read2']):
                errors.append(f"Sample {sample_id}: Marked as paired-end but read2 file missing/invalid: {row['read2']}")

    # region files for enrichment: present, non-empty, chromosome names matching the reference
    fai_names = {line.split("\t")[0] for line in open(config["reference_fai"]) if line.strip()}
    for name, path in USER_REGIONS.items():
        if not os.path.exists(path):
            errors.append(f"enrichment_regions['{name}']: file not found: {path}")
            continue
        with (gzip.open(path, "rt") if path.endswith(".gz") else open(path)) as f:
            chroms_seen = set()
            for line in f:
                if line.strip() and not line.startswith(("#", "track", "browser")):
                    chroms_seen.add(line.split("\t")[0])
                    if len(chroms_seen) > 1000:
                        break
        if not chroms_seen:
            errors.append(f"enrichment_regions['{name}']: {path} contains no regions")
        elif not chroms_seen & fai_names:
            errors.append(f"enrichment_regions['{name}']: chromosome names in {path} do not match the reference "
                          f"(e.g. '{sorted(chroms_seen)[0]}'; expected names like '{sorted(fai_names)[0]}')")

    # BAM input must be aligned to the configured reference (same chromosome names and lengths)
    fai = dict(line.rstrip("\n").split("\t")[:2] for line in open(config["reference_fai"]) if line.strip())
    chroms = [line.strip() for line in open(config["chromosome_file"]) if line.strip()]
    for unit, refs in BAM_REFS.items():
        bad = [c for c in chroms if c not in refs or str(refs[c]) != fai.get(c)]
        if bad:
            errors.append(f"Sample {units.loc[unit, 'sampleID']}: BAM {units.loc[unit, 'read1']} is not aligned to "
                          f"the configured reference (chromosomes missing or with different lengths: {bad[:5]})")

    # Validate that experimental samples and their controls have compatible sequencing types
    if config["igg_control"]:
        for sample_id, row in samplesheet.iterrows():
            if row['condition'] != 'Control':
                group_controls = samplesheet[(samplesheet['group'] == row['group']) & (samplesheet['condition'] == 'Control')]
                if len(group_controls) > 0:
                    control = group_controls.iloc[0]
                    if row['is_paired'] != control['is_paired']:
                        exp_type = "paired-end" if row['is_paired'] else "single-end"
                        ctrl_type = "paired-end" if control['is_paired'] else "single-end"
                        errors.append(f"Sample {sample_id} ({exp_type}) has incompatible sequencing type with its control {control.name} ({ctrl_type})")

    # Validate that at least one experimental sample exists
    if len(EXPERIMENT) == 0:
        errors.append("No experimental samples found. At least one non-Control sample is required for peak calling.")

    # Report results
    if errors:
        # in the exception message, so the errors are shown even when stdout is lost
        raise ValueError("Samplesheet validation failed:\n" + "\n".join(f"  {e}" for e in errors))

    if warnings:
        print("⚠️  Samplesheet validation warnings:")
        for warning in warnings:
            print(f"  {warning}")

    print(f"✅ Samplesheet validation passed")
    print(f"   📊 {len(PE_SAMPLES)} paired-end samples: {PE_SAMPLES}")
    print(f"   📊 {len(SE_SAMPLES)} single-end samples: {SE_SAMPLES}")
    print(f"   📈 Fragment analysis will be performed for {len(PE_SAMPLES)} paired-end samples only")
    print(f"   🧬 Duplicates removed for: {[s for s in SAMPLES if DEDUP[s]] or 'none'}")
    multi = {s: len(u) for s, u in SAMPLE_UNITS.items() if len(u) > 1}
    if multi:
        print(f"   🔗 Runs merged per sample (technical replicates): {multi}")
    if BAM_UNITS:
        print(f"   📦 BAM input: {sorted({units.loc[u, 'sampleID'] for u in BAM_UNITS})}")
    for condition, members in CONDITION_SAMPLES.items():
        if len({DEDUP[m] for m in members}) > 1:
            print(f"⚠️  Condition {condition}: duplicates removed for {[m for m in members if DEDUP[m]]} but not for "
                  f"{[m for m in members if not DEDUP[m]]}; its consensus peaks pool deduplicated and non-deduplicated data")
    single = sorted(set(CONDITION_SAMPLES) - set(CONSENSUS_CONDITIONS))
    if single:
        print(f"   ℹ️  No consensus peaks for single-replicate conditions: {single}")

# Run validation
validate_mixed_samplesheet()

rule all:
    input:
        expand("qc/{unit}_{r}", unit=UNIT_LIST, r=[1, 2]),
        "stats/stats.txt",
        "stats/peaks_consolidated.txt",
        expand("stats/seacr/{sample}.heatmap.png", sample=EXPERIMENT),
        expand("stats/seacr/{sample}_gc_content.txt", sample=EXPERIMENT),
        expand("stats/macs3/{sample}_gc_content.txt", sample=EXPERIMENT),
        # Fragment analysis only for paired-end samples
        expand("alignments/{sample}.fraglengths.txt", sample=PE_SAMPLES),
        "stats/region_enrichment.txt",
        "reports/cutntag_analysis_report.html",
        expand("tdf/{sample}.tdf", sample=SAMPLES),
        expand("bigwig/{sample}.bw", sample=SAMPLES),
        CONSENSUS_FILES,
        "stats/consensus_peaks.txt",
        "reports/multiqc_report.html",
        "reports/pipeline_info/software_versions.tsv",
        "tdf/igv_session.xml",


def trim_link(unit, mate=0):
    """Name under which a unit's FASTQ is passed to Trim Galore, so its report and the
    sample name MultiQC reads from it are the unit, not the (possibly repeated) file name."""
    gz = ".gz" if units.loc[unit, "read2" if mate == 2 else "read1"].endswith(".gz") else ""
    return f"trimmed/input/{unit}{f'_R{mate}' if mate else ''}.fastq{gz}"


def trimmed_reads(unit, mate):
    """Trimmed FASTQ of a unit (mate 1 or 2), or the raw FASTQ when trimming is disabled."""
    if not config["trim_adapters"]:
        return units.loc[unit, "read1" if mate == 1 else "read2"]
    if units.loc[unit, "is_paired"]:
        return f"trimmed/{unit}_val_{mate}.fq.gz"
    return f"trimmed/{unit}_trimmed.fq.gz"


rule check_quality_pe:
    input:
        r1=lambda w: trimmed_reads(w.unit, 1),
        r2=lambda w: trimmed_reads(w.unit, 2),
    output:
        out1=directory("qc/{unit}_1"),
        out2=directory("qc/{unit}_2"),
    wildcard_constraints:
        unit=constraint(FASTQ_PE_UNITS, "NO_PE_UNITS"),
    log:
        "logs/check_quality_pe/{unit}.log",
    conda:
        "envs/fastqc.yaml"
    shell:
        """
        mkdir -p {output.out1} {output.out2}
        fastqc -o {output.out1} {input.r1}
        fastqc -o {output.out2} {input.r2}
        """

rule check_quality_se:
    input:
        r1=lambda w: trimmed_reads(w.unit, 1),
    output:
        out1=directory("qc/{unit}_1"),
        out2=directory("qc/{unit}_2"),
    wildcard_constraints:
        unit=constraint(FASTQ_SE_UNITS, "NO_SE_UNITS"),
    log:
        "logs/check_quality_se/{unit}.log",
    conda:
        "envs/fastqc.yaml"
    shell:
        """
        mkdir -p {output.out1} {output.out2}
        fastqc -o {output.out1} {input.r1}
        echo "SINGLE_END_NO_R2_DATA" > {output.out2}/se_placeholder.txt
        """

rule check_quality_bam:
    input:
        bam=lambda w: units.loc[w.unit, "read1"],
    output:
        out1=directory("qc/{unit}_1"),
        out2=directory("qc/{unit}_2"),
    wildcard_constraints:
        unit=constraint(BAM_UNITS, "NO_BAM_UNITS"),
    log:
        "logs/check_quality_bam/{unit}.log",
    conda:
        "envs/fastqc.yaml"
    shell:
        """
        # FastQC reads BAM input directly (all reads, both mates)
        mkdir -p {output.out1} {output.out2}
        fastqc -o {output.out1} {input.bam}
        echo "BAM_INPUT_SEE_READ1_REPORT" > {output.out2}/bam_placeholder.txt
        """


rule trim_adapters_pe:
    input:
        r1=lambda w: units.loc[w.unit, "read1"],
        r2=lambda w: units.loc[w.unit, "read2"],
    output:
        out1="trimmed/{unit}_val_1.fq.gz",
        out2="trimmed/{unit}_val_2.fq.gz",
    wildcard_constraints:
        unit=constraint(FASTQ_PE_UNITS, "NO_PE_UNITS"),
    log:
        "logs/trim_adapters_pe/{unit}.log",
    conda:
        "envs/trim_galore.yaml"
    params:
        r1=lambda w, input: os.path.abspath(input.r1),
        r2=lambda w, input: os.path.abspath(input.r2),
        link1=lambda w: trim_link(w.unit, 1),
        link2=lambda w: trim_link(w.unit, 2),
    shell:
        """
        mkdir -p trimmed/input
        ln -sf {params.r1} {params.link1}
        ln -sf {params.r2} {params.link2}
        trim_galore --gzip --trim-n -o trimmed --basename {wildcards.unit} --paired {params.link1} {params.link2}
        rm -f {params.link1} {params.link2}
        """

rule trim_adapters_se:
    input:
        r1=lambda w: units.loc[w.unit, "read1"],
    output:
        out1="trimmed/{unit}_trimmed.fq.gz",
    wildcard_constraints:
        unit=constraint(FASTQ_SE_UNITS, "NO_SE_UNITS"),
    log:
        "logs/trim_adapters_se/{unit}.log",
    conda:
        "envs/trim_galore.yaml"
    params:
        r1=lambda w, input: os.path.abspath(input.r1),
        link1=lambda w: trim_link(w.unit),
    shell:
        """
        mkdir -p trimmed/input
        ln -sf {params.r1} {params.link1}
        trim_galore --gzip --trim-n -o trimmed --basename {wildcards.unit} {params.link1}
        rm -f {params.link1}
        """


rule align_reads_pe:
    input:
        ref=config["reference_fa"],
        r1=lambda w: trimmed_reads(w.unit, 1),
        r2=lambda w: trimmed_reads(w.unit, 2),
    output:
        sam=temp("alignments/units/{unit}.sam"),
        log="alignments/units/{unit}.bowtie2.txt",
    wildcard_constraints:
        unit=constraint(FASTQ_PE_UNITS, "NO_PE_UNITS"),
    log:
        "logs/align_reads_pe/{unit}.log",
    conda:
        "envs/bowtie.yaml"
    threads: 8
    params:
        aln="--local" if config["trim_adapters"] else "--end-to-end",
        ref=config["bt2_idx"],
    shell:
        """
        bowtie2 {params.aln} --very-sensitive --no-mixed --no-discordant --phred33 -I {config[fragment_min]} -X {config[fragment_max]} -p {threads} -x {params.ref} -1 {input.r1} -2 {input.r2} -S {output.sam} |& tee {output.log}
        """

rule align_reads_se:
    input:
        ref=config["reference_fa"],
        r1=lambda w: trimmed_reads(w.unit, 1),
    output:
        sam=temp("alignments/units/{unit}.sam"),
        log="alignments/units/{unit}.bowtie2.txt",
    wildcard_constraints:
        unit=constraint(FASTQ_SE_UNITS, "NO_SE_UNITS"),
    log:
        "logs/align_reads_se/{unit}.log",
    conda:
        "envs/bowtie.yaml"
    threads: 8
    params:
        aln="--local" if config["trim_adapters"] else "--end-to-end",
        ref=config["bt2_idx"],
    shell:
        """
        bowtie2 {params.aln} --very-sensitive --phred33 -p {threads} -x {params.ref} -U {input.r1} -S {output.sam} |& tee {output.log}
        """


rule convert_to_binary:
    input:
        "alignments/units/{unit}.sam",
    output:
        bam=temp("alignments/units/{unit}.bam"),
    wildcard_constraints:
        unit=constraint(FASTQ_PE_UNITS + FASTQ_SE_UNITS, "NO_FASTQ_UNITS"),
    log:
        "logs/convert_to_binary/{unit}.log",
    conda:
        "envs/samtools.yaml"
    threads: 2
    shell:
        """
        samtools view -S -b {input} | samtools sort -@ {threads} -o {output.bam}
        """

rule import_bam:
    input:
        bam=lambda w: units.loc[w.unit, "read1"],
    output:
        bam=temp("alignments/units/{unit}.bam"),
    wildcard_constraints:
        unit=constraint(BAM_UNITS, "NO_BAM_UNITS"),
    log:
        "logs/import_bam/{unit}.log",
    conda:
        "envs/samtools.yaml"
    threads: 2
    shell:
        """
        # user-supplied alignments: coordinate-sort (input may be unsorted or name-sorted)
        samtools sort -@ {threads} -o {output.bam} {input.bam} 2> {log}
        """

rule merge_units:
    input:
        lambda w: expand("alignments/units/{unit}.bam", unit=SAMPLE_UNITS[w.sample]),
    output:
        bam=temp("alignments/{sample}.sorted.bam"),
    log:
        "logs/merge_units/{sample}.log",
    conda:
        "envs/samtools.yaml"
    threads: 2
    shell:
        """
        # runs (technical replicates) of a sample are merged before duplicate removal
        bams=({input})
        if [ ${{#bams[@]}} -eq 1 ]; then
            cp {input} {output.bam}
        else
            samtools merge -f -@ {threads} -o {output.bam} {input} 2> {log}
        fi
        """


rule index_bam:
    input:
        bam="alignments/{sample}.sorted.bam",
    output:
        bai=temp("alignments/{sample}.sorted.bam.bai"),
    log:
        "logs/index_bam/{sample}.log",
    conda:
        "envs/samtools.yaml"
    shell:
        """
        samtools index {input.bam}
        """


rule remove_duplicates:
    input:
        bam="alignments/{sample}.sorted.bam",
        bai="alignments/{sample}.sorted.bam.bai",
    output:
        bam="dedupalignments/{sample}.sorted.bam",
        metrics="dedupalignments/{sample}.rmdup.txt",
    log:
        "logs/remove_duplicates/{sample}.log",
    conda:
        "envs/picard.yaml"
    params:
        dedup_sample=lambda w: "yes" if DEDUP[w.sample] else "no",
    shell:
        """
        # Picard (Java) ignores TMPDIR; put its spill files in the job's tmpdir rather than the node's /tmp
        mkdir -p dedupalignments
        if [ {params.dedup_sample} = yes ]; then
            picard MarkDuplicates -I {input.bam} -O {output.bam} -METRICS_FILE {output.metrics} -REMOVE_DUPLICATES true -TMP_DIR {resources.tmpdir} 2> {log}
        else
            # duplication metrics only; downstream steps use the alignments unchanged
            picard MarkDuplicates -I {input.bam} -O /dev/null -METRICS_FILE {output.metrics} -TMP_DIR {resources.tmpdir} 2> {log}
            cp {input.bam} {output.bam}
        fi
        """


use rule index_bam as index_dedup_bam with:
    input:
        bam="dedupalignments/{sample}.sorted.bam",
    output:
        bai="dedupalignments/{sample}.sorted.bam.bai",
    log:
        "logs/index_dedup_bam/{sample}.log",


rule find_mtdna_reads:
    input:
        bam="alignments/{sample}.sorted.bam",
        bai="alignments/{sample}.sorted.bam.bai",
    output:
        "alignments/{sample}.mtdna.txt",
    log:
        "logs/find_mtdna_reads/{sample}.log",
    conda:
        "envs/samtools.yaml"
    params:
        mtdna=config["mt_chrom"],
    shell:
        """
        # one count per fragment: skip read 2 (0x80), unmapped, secondary, supplementary; works for SE and PE
        samtools view -c -F 0x984 {input.bam} {params.mtdna} > {output}
        """


# Alignment statistics from the merged raw BAM (same for FASTQ and BAM input).
# A fragment is a read pair (paired-end, counted via read 1) or a read (single-end).
rule alignment_stats:
    input:
        bam="alignments/{sample}.sorted.bam",
        bai="alignments/{sample}.sorted.bam.bai",
    output:
        "alignments/{sample}.alnstats.txt",
    log:
        "logs/alignment_stats/{sample}.log",
    conda:
        "envs/samtools.yaml"
    params:
        total=lambda w: "-f 0x40 -F 0x900" if samplesheet.loc[w.sample, "is_paired"] else "-F 0x900",
        mapped=lambda w: "-f 0x42 -F 0x904" if samplesheet.loc[w.sample, "is_paired"] else "-F 0x904",
        unaligned=lambda w: "-f 0x44 -F 0x900" if samplesheet.loc[w.sample, "is_paired"] else "-f 0x4 -F 0x900",
        paired=lambda w: "yes" if samplesheet.loc[w.sample, "is_paired"] else "no",
    shell:
        """
        # paired-end "mapped" = properly paired; "unique" = no alternative alignment (XS tag)
        # for the read, or for either mate of a pair (as in the Bowtie2 summary)
        total=$(samtools view -c {params.total} {input.bam})
        mapped=$(samtools view -c {params.mapped} {input.bam})
        if [ {params.paired} = yes ]; then
            multi=$(samtools view -f 0x2 -F 0x904 -e 'exists([XS])' {input.bam} | cut -f 1 | LC_ALL=C sort -u | wc -l)
            unique=$((mapped - multi))
        else
            unique=$(samtools view -c {params.mapped} -e '!exists([XS])' {input.bam})
        fi
        unaligned=$(samtools view -c {params.unaligned} {input.bam})
        printf "total\\t%s\\nmapped\\t%s\\nunique\\t%s\\nunaligned\\t%s\\n" $total $mapped $unique $unaligned > {output}
        """

# ENCODE library complexity (NRF, PBC1, PBC2) before duplicate removal, after the
# MAPQ and chromosome filters used for peak calling.
rule library_complexity:
    input:
        bam="alignments/{sample}.sorted.bam",
        bai="alignments/{sample}.sorted.bam.bai",
    output:
        "alignments/{sample}.complexity.txt",
    log:
        "logs/library_complexity/{sample}.log",
    conda:
        "envs/samtools.yaml"
    params:
        chroms=config["chromosome_file"],
        minq=config["minquality"],
        paired=lambda w: "yes" if samplesheet.loc[w.sample, "is_paired"] else "no",
        flags=lambda w: "-f 0x42 -F 0x904" if samplesheet.loc[w.sample, "is_paired"] else "-F 0x904",
    shell:
        """
        samtools view -q {params.minq} {params.flags} {input.bam} $(tr '\\n' ' ' < {params.chroms}) \\
        | awk -v paired={params.paired} -f {workflow.basedir}/scripts/fragment_keys.awk \\
        | LC_ALL=C sort -S 1G | uniq -c \\
        | awk -v OFS="\\t" '{{n = $1; total += n; distinct++; if (n == 1) m1++; if (n == 2) m2++}}
            END {{print "NRF", "PBC1", "PBC2"
                 if (distinct == 0) {{print "NA", "NA", "NA"; exit}}
                 print sprintf("%.3f", distinct / total), sprintf("%.3f", m1 / distinct), (m2 > 0) ? sprintf("%.2f", m1 / m2) : "NA"}}' \\
        > {output}
        """


# Spike-in (carry-over E. coli DNA from pA-Tn5, or another genome in contaminant_genomes):
# reads that did not align to the host are aligned to the spike-in genome and counted as
# fragments, deduplicated like the sample's host alignments.
rule spikein_reads:
    input:
        bam="alignments/{sample}.sorted.bam",
    output:
        fq=temp("spikein/{sample}.fq.gz"),
    log:
        "logs/spikein_reads/{sample}.log",
    conda:
        "envs/samtools.yaml"
    params:
        paired=lambda w: "yes" if samplesheet.loc[w.sample, "is_paired"] else "no",
    shell:
        """
        tmp=$(mktemp -d spikein/{wildcards.sample}.XXXXXX)
        trap 'rm -rf "$tmp"' EXIT
        if [ {params.paired} = yes ]; then
            # pairs with neither mate aligned to the host, mates adjacent (interleaved)
            samtools view -u -f 12 -F 0x900 {input.bam} | samtools collate -u -O - $tmp/collate \\
            | samtools fastq -n - 2> {log} | gzip > {output.fq}
        else
            samtools view -u -f 4 -F 0x900 {input.bam} | samtools fastq -n - 2> {log} | gzip > {output.fq}
        fi
        """

rule align_spikein:
    input:
        fq="spikein/{sample}.fq.gz",
    output:
        sam=temp("spikein/{sample}.sam"),
    log:
        "logs/align_spikein/{sample}.log",
    conda:
        "envs/bowtie.yaml"
    threads: 4
    params:
        aln="--local" if config["trim_adapters"] else "--end-to-end",
        idx=CONTAMINANTS.get(config["spikein_genome"], ""),
        reads=lambda w: (f"--no-mixed --no-discordant -I {config['fragment_min']} -X {config['fragment_max']} --interleaved"
                         if samplesheet.loc[w.sample, "is_paired"] else "-U"),
    shell:
        """
        if [ $(gzip -dc {input.fq} | wc -l) -eq 0 ]; then
            echo "no reads unaligned to the host (BAM input without unmapped reads?)" > {log}
            touch {output.sam}
        else
            bowtie2 {params.aln} --very-sensitive --phred33 -p {threads} -x {params.idx} \\
                {params.reads} {input.fq} -S {output.sam} 2> {log}
        fi
        """

rule count_spikein:
    input:
        sam="spikein/{sample}.sam",
    output:
        "alignments/{sample}.spikein.txt",
    log:
        "logs/count_spikein/{sample}.log",
    conda:
        "envs/samtools.yaml"
    params:
        minq=config["minquality"],
        paired=lambda w: "yes" if samplesheet.loc[w.sample, "is_paired"] else "no",
        flags=lambda w: "-f 0x42 -F 0x904" if samplesheet.loc[w.sample, "is_paired"] else "-F 0x904",
        dedup=lambda w: "yes" if DEDUP[w.sample] else "no",
        required="yes" if SPIKEIN_NORM else "no",
    shell:
        """
        n=0
        if [ -s {input.sam} ]; then
            n=$(samtools view -q {params.minq} {params.flags} {input.sam} \\
                | awk -v paired={params.paired} -f {workflow.basedir}/scripts/fragment_keys.awk \\
                | if [ {params.dedup} = yes ]; then LC_ALL=C sort -u -S 1G; else cat; fi | wc -l)
        fi
        printf "spikein_fragments\\n%s\\n" $n > {output}
        if [ $n -eq 0 ] && [ {params.required} = yes ]; then
            echo "ERROR: no spike-in fragments for {wildcards.sample}; spike-in normalization is not possible (use normalization cpm)" >&2
            exit 1
        elif [ $n -lt 1000 ]; then
            echo "WARNING: only $n spike-in fragments for {wildcards.sample}; spike-in scale factors will be noisy" > {log}
        fi
        """


# One row per sample (biological replicate) for the R scripts and the report
SAMPLE_TABLE = samplesheet.reset_index()[["sampleID", "condition", "group", "input", "units"]].assign(
    layout=["PE" if p else "SE" for p in samplesheet["is_paired"]],
    deduplicated=["yes" if DEDUP[s] else "no" for s in samplesheet.index],
).to_csv(sep="\t", index=False)

rule sample_table:
    output:
        "stats/samples.tsv",
    log:
        "logs/sample_table/job.log",
    params:
        table=SAMPLE_TABLE,  # a changed samplesheet or dedup setting changes params and reruns the rule
    run:
        with open(output[0], "w") as out:
            out.write(params.table)


def screen_reads(wildcards):
    """Read 1 of every run of the sample (trimmed if enabled; extracted from BAM input)."""
    return [f"qc/fastq_screen/units/{u}.R1.fq.gz" if units.loc[u, "is_bam"] else trimmed_reads(u, 1)
            for u in SAMPLE_UNITS[wildcards.sample]]


rule bam_read1:
    input:
        bam=lambda w: units.loc[w.unit, "read1"],
    output:
        temp("qc/fastq_screen/units/{unit}.R1.fq.gz"),
    wildcard_constraints:
        unit=constraint(BAM_UNITS, "NO_BAM_UNITS"),
    log:
        "logs/bam_read1/{unit}.log",
    conda:
        "envs/samtools.yaml"
    params:
        flags=lambda w: "-f 0x40 -F 0x900" if units.loc[w.unit, "is_paired"] else "-F 0x900",
    shell:
        """
        samtools fastq -n {params.flags} {input.bam} 2> {log} | gzip > {output}
        """


# Host genome is screened alongside contaminants so reads shared between
# genomes are classified as multi-genome rather than counted as contamination
rule screen_contaminants:
    input:
        reads=screen_reads,
    output:
        txt="qc/fastq_screen/{sample}_screen.txt",
    log:
        "logs/screen_contaminants/{sample}.log",
    conda:
        "envs/fastq_screen.yaml"
    threads: 4
    params:
        databases=" ".join(
            f"'DATABASE {name} {idx}'"
            for name, idx in [("Host", config["bt2_idx"])] + list(CONTAMINANTS.items())
        ),
        subset=config["contaminant_subset"],
    shell:
        """
        tmp=$(mktemp -d qc/fastq_screen/{wildcards.sample}.XXXXXX)
        trap 'rm -rf "$tmp"' EXIT
        printf '%s\\n' {params.databases} > $tmp/fastq_screen.conf
        # runs of a sample are screened together
        reads=({input.reads})
        if [ ${{#reads[@]}} -gt 1 ]; then
            cat "${{reads[@]}}" > $tmp/{wildcards.sample}.fq.gz
            reads=($tmp/{wildcards.sample}.fq.gz)
        fi
        fastq_screen --conf $tmp/fastq_screen.conf --aligner bowtie2 \\
            --subset {params.subset} --threads {threads} --outdir $tmp --force \\
            "${{reads[0]}}" > {log} 2>&1
        mv $tmp/*_screen.txt {output.txt}
        """


rule report_on_alignments:
    input:
        aln=expand("alignments/{sample}.alnstats.txt", sample=SAMPLES),
        complexity=expand("alignments/{sample}.complexity.txt", sample=SAMPLES),
        mtn=expand("alignments/{sample}.mtdna.txt", sample=SAMPLES),
        dup=expand("dedupalignments/{sample}.rmdup.txt", sample=SAMPLES),
        screen=expand("qc/fastq_screen/{sample}_screen.txt", sample=SAMPLES),
        spikein=expand("alignments/{sample}.spikein.txt", sample=SAMPLES) if SPIKEIN else [],
    output:
        "stats/stats.txt",
    log:
        "logs/report_on_alignments/job.log",
    conda:
        "envs/R.yaml"
    params:
        contaminants=list(CONTAMINANTS),
        dedup_samples=[s for s in SAMPLES if DEDUP[s]],
    script:
        "scripts/run_alignment_report.R"


rule fragment_size:
    input:
        "alignments/{sample}.sorted.bam",
    output:
        "alignments/{sample}.fraglengths.txt",
    wildcard_constraints:
        sample="|".join(PE_SAMPLES) if PE_SAMPLES else "NO_PE_SAMPLES"
    log:
        "logs/fragment_size/{sample}.log",
    conda:
        "envs/samtools.yaml"
    shell:
        """
        # Extract insert sizes for paired-end only
        samtools view -f 1 -F 0x04 {input} \
        | awk -F"\\t" 'function abs(x){{return ((x < 0.0) ? -x : x)}} {{print abs($9)}}' \
        | sort -n | uniq -c \
        | awk -v OFS="\\t" '{{print $2, $1/2}}' > {output}
        """




# we filter all reads overlapping the blacklist, remove non-primary and sex
# chromosomes and remove low-quality reads to create the bedgraph file which
# is given to the peak caller
rule bam_to_bed_pe:
    input:
        fai=config["reference_fai"],
        blklist=config["blacklist"],
        bai="dedupalignments/{sample}.sorted.bam.bai",
        bam="dedupalignments/{sample}.sorted.bam",
        spikein=lambda w: f"alignments/{w.sample}.spikein.txt" if SPIKEIN_NORM else [],
    output:
        bam=temp("{sample}.name.bam"),
        qbam="dedupalignments/{sample}.sorted.qflt.bam",
        qbai="dedupalignments/{sample}.sorted.qflt.bam.bai",
        bed=temp("bedalignments/{sample}.bed"),
        bedgraph="bedalignments/{sample}.bedgraph",
        norm_bedgraph=temp("bedalignments/{sample}.norm.bedgraph"),
        binbed="bedalignments/{sample}.bin.bed",
        fragments=temp("bedalignments/{sample}.fragments.bed"),
    wildcard_constraints:
        sample="|".join(PE_SAMPLES) if PE_SAMPLES else "NO_PE_SAMPLES"
    log:
        "logs/bam_to_bed_pe/{sample}.log",
    params:
        chroms=config["chromosome_file"],
        minq=config["minquality"],
        mt=config["mt_chrom"],
    conda:
        "envs/bedtools.yaml"
    threads: 2
    shell:
        """
        # Paired-end processing
        # -f 1: Require read paired in sequencing
        # -F 3852: Exclude unmapped(4), mate unmapped(8), not primary(256), QC-fail(512), duplicate(1024), supplementary(2048)
        samtools view -h -q {params.minq} -f 1 -F 3852 {input.bam} $(tr '\\n' ' ' < {params.chroms}) \
        | awk -F "\\t" '/^@/ {{print; next}} ($7=="=" && $9 <= 1000 && $9 >= -1000) {{print}}' \
        | samtools view -b \
        | bedtools intersect -abam - -b {input.blklist} -v \
        > {output.qbam}

        samtools index {output.qbam}
        samtools sort -@ {threads} -n -O BAM -o {output.bam} {output.qbam}

        # Convert to BEDPE format for paired-end
        bedtools bamtobed -i {output.bam} -bedpe \
        | cut -f 1,2,6 \
        | sort -k1,1 -k2,2n -k3,3n \
        > {output.bed}
        cp {output.bed} {output.fragments}

        # Common processing
        bedtools genomecov -bg -i {output.bed} \
            -g <(cut -f 1,2 {input.fai}) > {output.bedgraph}

        # normalized coverage for the TDF and bigWig tracks: per million filtered, non-mitochondrial
        # fragments (CPM), or per 10,000 spike-in fragments (normalization: spikein)
        if [ -n "{input.spikein}" ]; then
            scale=$(awk 'NR == 2 {{print 10000 / $1}}' {input.spikein})
        else
            scale=$(awk -v mt="{params.mt}" '$1 != mt {{n++}} END {{print (n > 0) ? 1000000/n : 0}}' {output.bed})
        fi
        echo "scale factor: $scale" > {log}
        bedtools genomecov -bg -scale $scale -i {output.bed} \
            -g <(cut -f 1,2 {input.fai}) > {output.norm_bedgraph}

        awk -v w=500 '{{print $1, int(($2 + $3)/(2*w))*w + w/2}}' {output.bed} \
        | sort -k1,1V -k2,2n \
        | uniq -c \
        | awk -v OFS="\\t" '{{print $2, $3, $1}}' \
        | sort -k1,1V -k2,2n > {output.binbed}
        """

rule bam_to_bed_se:
    input:
        fai=config["reference_fai"],
        blklist=config["blacklist"],
        bai="dedupalignments/{sample}.sorted.bam.bai",
        bam="dedupalignments/{sample}.sorted.bam",
        spikein=lambda w: f"alignments/{w.sample}.spikein.txt" if SPIKEIN_NORM else [],
    output:
        bam=temp("{sample}.name.bam"),
        qbam="dedupalignments/{sample}.sorted.qflt.bam",
        qbai="dedupalignments/{sample}.sorted.qflt.bam.bai",
        bed=temp("bedalignments/{sample}.bed"),
        bedgraph="bedalignments/{sample}.bedgraph",
        norm_bedgraph=temp("bedalignments/{sample}.norm.bedgraph"),
        binbed="bedalignments/{sample}.bin.bed",
        fragments=temp("bedalignments/{sample}.fragments.bed"),
    wildcard_constraints:
        sample="|".join(SE_SAMPLES) if SE_SAMPLES else "NO_SE_SAMPLES"
    log:
        "logs/bam_to_bed_se/{sample}.log",
    params:
        chroms=config["chromosome_file"],
        minq=config["minquality"],
        mt=config["mt_chrom"],
    conda:
        "envs/bedtools.yaml"
    threads: 2
    shell:
        """
        # Single-end processing
        # -F 3844: Exclude unmapped(4), not primary(256), QC-fail(512), duplicate(1024), supplementary(2048)
        # Note: Flag 8 (mate unmapped) is included but harmless for SE data
        samtools view -h -q {params.minq} -F 3844 {input.bam} $(tr '\\n' ' ' < {params.chroms}) \
        | samtools view -b \
        | bedtools intersect -abam - -b {input.blklist} -v \
        > {output.qbam}

        samtools index {output.qbam}
        samtools sort -@ {threads} -n -O BAM -o {output.bam} {output.qbam}

        # Convert to BED format for single-end
        bedtools bamtobed -i {output.bam} \
        | sort -k1,1 -k2,2n -k3,3n \
        > {output.bed}

        # Pseudo-fragments for pooled peak calling: reads extended to 147 bp along their strand
        awk -v OFS="\\t" 'NR == FNR {{len[$1] = $2; next}}
            {{if ($6 == "-") {{s = $3 - 147; e = $3}} else {{s = $2; e = $2 + 147}}
              if (s < 0) s = 0; if (e > len[$1]) e = len[$1]; print $1, s, e}}' \
            {input.fai} {output.bed} | sort -k1,1 -k2,2n > {output.fragments}

        # Common processing
        bedtools genomecov -bg -i {output.bed} \
            -g <(cut -f 1,2 {input.fai}) > {output.bedgraph}

        # normalized coverage for the TDF and bigWig tracks: per million filtered, non-mitochondrial
        # fragments (CPM), or per 10,000 spike-in fragments (normalization: spikein)
        if [ -n "{input.spikein}" ]; then
            scale=$(awk 'NR == 2 {{print 10000 / $1}}' {input.spikein})
        else
            scale=$(awk -v mt="{params.mt}" '$1 != mt {{n++}} END {{print (n > 0) ? 1000000/n : 0}}' {output.bed})
        fi
        echo "scale factor: $scale" > {log}
        bedtools genomecov -bg -scale $scale -i {output.bed} \
            -g <(cut -f 1,2 {input.fai}) > {output.norm_bedgraph}

        awk -v w=500 '{{print $1, int(($2 + $3)/(2*w))*w + w/2}}' {output.bed} \
        | sort -k1,1V -k2,2n \
        | uniq -c \
        | awk -v OFS="\\t" '{{print $2, $3, $1}}' \
        | sort -k1,1V -k2,2n > {output.binbed}
        """

rule calculate_seacr_peak_gc:
    input:
        peaks="peaks/seacr/{sample}.peaks.stringent.bed",
        fasta=config["reference_fa"],
    output:
        gc_stats="stats/seacr/{sample}_gc_content.txt",
    wildcard_constraints:
        sample="|".join(EXPERIMENT) if EXPERIMENT else "NO_EXPERIMENT_SAMPLES"
    log:
        "logs/calculate_peak_gc/seacr_{sample}.log",
    conda:
        "envs/bedtools.yaml"
    shell:
        """
        if [ -s {input.peaks} ]; then
            bedtools nuc -fi {input.fasta} -bed {input.peaks} | \
            awk -F'\\t' 'NR==1 {{for (i = 1; i <= NF; i++) if ($i ~ /pct_gc$/) c = i; next}} {{print $c}}' | \
            sort -n | \
            awk '{{a[NR]=$1}} END {{n=NR; if(n==0) print "{wildcards.sample}", 0; else if(n%2==1) print "{wildcards.sample}", a[(n+1)/2]; else print "{wildcards.sample}", (a[n/2]+a[n/2+1])/2}}' \
            > {output.gc_stats}
        else
            echo "{wildcards.sample} 0" > {output.gc_stats}
        fi
        """

