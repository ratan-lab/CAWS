# MultiQC report of FastQC, Trim Galore, Bowtie2, Picard and FastQ Screen output
# ---------------------------------------------------------------------------
rule multiqc:
    input:
        fastqc=expand("qc/{unit}_{r}", unit=UNIT_LIST, r=[1, 2]),
        screen=expand("qc/fastq_screen/{sample}_screen.txt", sample=SAMPLES),
        aln=expand("alignments/units/{unit}.bowtie2.txt", unit=FASTQ_PE_UNITS + FASTQ_SE_UNITS),
        dup=expand("dedupalignments/{sample}.rmdup.txt", sample=SAMPLES),
    output:
        "reports/multiqc_report.html",
    log:
        "logs/multiqc/job.log",
    conda:
        "envs/multiqc.yaml"
    params:
        config=f"{workflow.basedir}/multiqc_config.yaml",
        dirs="qc alignments dedupalignments" + (" trimmed" if config["trim_adapters"] else ""),
    shell:
        """
        multiqc --force --config {params.config} --outdir reports --filename multiqc_report.html \\
            --ignore '*.fq.gz' --ignore '*.fastq.gz' --ignore '*.bam' --ignore '*.bai' \\
            {params.dirs} > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Record the configuration and pinned software versions of the run
# ---------------------------------------------------------------------------
rule pipeline_info:
    input:
        envs=sorted(str(p) for p in Path(workflow.basedir, "envs").glob("*.yaml")),
    output:
        versions="reports/pipeline_info/software_versions.tsv",
        config="reports/pipeline_info/config.json",
        samplesheet="reports/pipeline_info/samplesheet.tsv",
    log:
        "logs/pipeline_info/job.log",
    run:
        import json, shutil, subprocess, yaml
        import snakemake as smk
        try:
            commit = subprocess.run(["git", "-C", workflow.basedir, "describe", "--tags", "--always", "--dirty"],
                                    capture_output=True, text=True, check=True).stdout.strip()
        except Exception:
            commit = "unknown"
        with open(output.versions, "w") as out:
            out.write("environment\tpackage\tversion\n")
            out.write(f"workflow\tCAWS\t{commit}\n")
            out.write(f"workflow\tsnakemake\t{smk.__version__}\n")
            for env in input.envs:
                for dep in yaml.safe_load(open(env)).get("dependencies", []):
                    if isinstance(dep, str):
                        # "tool=1.2=build", "tool==1.2" or "tool>=1.2": keep the name and version spec, drop builds
                        name, spec = re.match(r"([^=<>!\s]+)\s*(.*)", dep).groups()
                        version = spec.lstrip("=").split("=")[0] if spec.startswith("=") else spec
                        out.write(f"{Path(env).stem}\t{name}\t{version or 'unpinned'}\n")
        with open(output.config, "w") as out:
            json.dump(config, out, indent=4)
        shutil.copy(config["samplesheet"], output.samplesheet)


# ---------------------------------------------------------------------------
# IGV session with coverage tracks and peak calls (paths relative to tdf/)
# ---------------------------------------------------------------------------
IGV_PEAKS = (expand("peaks/seacr/{sample}.peaks.stringent.bed", sample=EXPERIMENT)
             + expand(f"peaks/macs3/{{sample}}{MACS_SUFFIX}", sample=EXPERIMENT))

rule igv_session:
    input:
        tdf=expand("tdf/{sample}.tdf", sample=SAMPLES),
        peaks=IGV_PEAKS,
        consensus=CONSENSUS_FILES,
    output:
        "tdf/igv_session.xml",
    log:
        "logs/igv_session/job.log",
    run:
        from xml.sax.saxutils import quoteattr
        genome = config["igv_genome"]
        if os.path.isfile(genome):
            # IGV cannot use a chrom.sizes file as a genome; use the indexed reference FASTA instead
            genome = os.path.abspath(config["reference_fa"] if genome.endswith(".sizes") else genome)
        # experimental samples grouped by condition, then controls
        order = sorted(EXPERIMENT, key=lambda s: (samplesheet.loc[s, "condition"], s)) + CONTROL
        tracks = [(f"{s}.tdf", s) for s in order]
        tracks += [(f"../{p}", f"{Path(p).parts[-2]} consensus: {Path(p).name.removesuffix('.consensus.bed')}")
                   for p in input.consensus]
        tracks += [(f"../{p}", f"{Path(p).parts[-2]}: {Path(p).name.removesuffix('.peaks.stringent.bed').removesuffix(MACS_SUFFIX)}")
                   for p in input.peaks]
        with open(output[0], "w") as out:
            out.write('<?xml version="1.0" encoding="UTF-8" standalone="no"?>\n')
            out.write(f'<Session genome={quoteattr(genome)} locus="All" version="8">\n    <Resources>\n')
            for path, name in tracks:
                out.write(f"        <Resource name={quoteattr(name)} path={quoteattr(path)}/>\n")
            out.write("    </Resources>\n</Session>\n")
