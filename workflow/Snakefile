        igvtools toTDF {input.bedgraph} {output.tdf} {params.igv_genome} 2> {log}
        """

rule normalized_bigwig:
    input:
        bedgraph="bedalignments/{sample}.norm.bedgraph",
        fai=config["reference_fai"],
    output:
        "bigwig/{sample}.bw",
    log:
        "logs/normalized_bigwig/{sample}.log",
    conda:
        "envs/ucsc.yaml"
    shell:
        """
        tmp=$(mktemp -d bigwig/{wildcards.sample}.XXXXXX)
        trap 'rm -rf "$tmp"' EXIT
        LC_ALL=C sort -k1,1 -k2,2n {input.bedgraph} > $tmp/coverage.bedgraph
        cut -f 1,2 {input.fai} > $tmp/chrom.sizes
        bedGraphToBigWig $tmp/coverage.bedgraph $tmp/chrom.sizes {output} 2> {log}
        """

ruleorder: bam_to_bed_pe > bam_to_bed_se
ruleorder: call_macs_peaks_pe > call_macs_peaks_se



# ---------------------------------------------------------------------------
# Consensus peaks (ENCODE-style): call peaks on pooled replicates of each
# condition, keep pooled peaks supported by >= consensus_min_replicates replicates
# ---------------------------------------------------------------------------
rule pool_replicates:
    input:
        exp=lambda w: expand("bedalignments/{s}.fragments.bed", s=CONDITION_SAMPLES[w.condition]),
        con=lambda w: expand("bedalignments/{s}.fragments.bed", s=condition_controls(w.condition)),
    output:
        exp=temp("peaks/consensus/pooled/{condition}.fragments.bed"),
        con=temp("peaks/consensus/pooled/{condition}.control.fragments.bed"),
    log:
        "logs/pool_replicates/{condition}.log",
    threads: 2
    shell:
        """
        sort --parallel={threads} -k1,1 -k2,2n {input.exp} > {output.exp}
        if [ -n "{input.con}" ]; then
            sort --parallel={threads} -k1,1 -k2,2n {input.con} > {output.con}
        else
            touch {output.con}
        fi
        """

rule call_seacr_pooled:
    input:
        exp="peaks/consensus/pooled/{condition}.fragments.bed",
        con="peaks/consensus/pooled/{condition}.control.fragments.bed",
        fai=config["reference_fai"],
    output:
        "peaks/consensus/seacr/{condition}.pooled.stringent.bed",
    log:
        "logs/call_seacr_pooled/{condition}.log",
    conda:
        "envs/seacr.yaml"
    params:
        has_igg=config["igg_control"],
    shell:
        """
        tmp=$(mktemp -d peaks/consensus/seacr/{wildcards.condition}.XXXXXX)
        trap 'rm -rf "$tmp"' EXIT
        bedtools genomecov -bg -i {input.exp} -g <(cut -f 1,2 {input.fai}) > $tmp/exp.bedgraph
        if [ {params.has_igg} == True ]; then
            bedtools genomecov -bg -i {input.con} -g <(cut -f 1,2 {input.fai}) > $tmp/con.bedgraph
            bash `which SEACR_1.3.sh` $tmp/exp.bedgraph $tmp/con.bedgraph norm stringent $tmp/out > {log} 2>&1 || true
        else
            bash `which SEACR_1.3.sh` $tmp/exp.bedgraph {config[seacr_qvalue]} norm stringent $tmp/out > {log} 2>&1 || true
        fi
        if [ -f $tmp/out.stringent.bed ]; then mv $tmp/out.stringent.bed {output}; else touch {output}; fi
        """

rule call_macs_pooled:
    input:
        exp="peaks/consensus/pooled/{condition}.fragments.bed",
        con="peaks/consensus/pooled/{condition}.control.fragments.bed",
    output:
        f"peaks/consensus/macs3/{{condition}}.pooled{MACS_SUFFIX}",
    log:
        "logs/call_macs_pooled/{condition}.log",
    conda:
        "envs/macs.yaml"
    params:
        has_igg=config["igg_control"],
        mode=MACS_MODE,
    shell:
        """
        # pooled fragments (PE fragments, SE reads extended to 147 bp) are given to MACS3 as BEDPE
        if [ {params.has_igg} == True ]; then
            macs3 callpeak -t {input.exp} -c {input.con} -f BEDPE -g {config[genome_size]} -n "{wildcards.condition}.pooled" \\
                --outdir peaks/consensus/macs3 {params.mode} --keep-dup all -q {config[macs3_qvalue_with_control]} 2> {log} || true
        else
            macs3 callpeak -t {input.exp} -f BEDPE -g {config[genome_size]} -n "{wildcards.condition}.pooled" \\
                --outdir peaks/consensus/macs3 {params.mode} --keep-dup all -q {config[macs3_qvalue_no_control]} --nolambda 2> {log} || true
        fi
        [ -f {output} ] || touch {output}
        """

rule consensus_peaks:
    input:
        pooled=lambda w: pooled_peaks(w.caller, w.condition),
        reps=lambda w: replicate_peaks(w.caller, w.condition),
    output:
        "peaks/consensus/{caller}/{condition}.consensus.bed",
    log:
        "logs/consensus_peaks/{caller}_{condition}.log",
    conda:
        "envs/bedtools.yaml"
    params:
        names=lambda w: CONDITION_SAMPLES[w.condition],
        k=lambda w: consensus_threshold(w.condition),
    shell:
        """
        # a pooled peak is supported by a replicate if they overlap by >= 50% of either peak (ENCODE rule)
        tmp=$(mktemp -d peaks/consensus/{wildcards.caller}/{wildcards.condition}.XXXXXX)
        trap 'rm -rf "$tmp"' EXIT
        cut -f 1-3 {input.pooled} | sort -u -k1,1 -k2,2n -k3,3n > $tmp/pooled.bed
        names=({params.names})
        reps=({input.reps})
        : > $tmp/support.bed
        for i in "${{!reps[@]}}"; do
            [ -s "${{reps[$i]}}" ] || continue
            bedtools intersect -a $tmp/pooled.bed -b <(cut -f 1-3 "${{reps[$i]}}") -f 0.5 -F 0.5 -e -u \\
                | awk -v OFS="\\t" -v n="${{names[$i]}}" '{{print $1, $2, $3, n}}' >> $tmp/support.bed
        done
        sort -k1,1 -k2,2n -k3,3n -k4,4 $tmp/support.bed \\
        | awk -v OFS="\\t" -v k={params.k} '
            {{key = $1 OFS $2 OFS $3
              if (key != prev) {{if (prev != "" && n >= k) print prev, n, ids; prev = key; n = 0; ids = ""}}
              n++; ids = ids (ids == "" ? "" : ",") $4}}
            END {{if (prev != "" && n >= k) print prev, n, ids}}' > {output}
        """

rule consensus_summary:
    input:
        pooled=[pooled_peaks(c, d) for c in ["seacr", "macs3"] for d in CONSENSUS_CONDITIONS],
        consensus=CONSENSUS_FILES,
    output:
        "stats/consensus_peaks.txt",
    log:
        "logs/consensus_summary/job.log",
    run:
        import statistics
        def intervals(path):
            with open(path) as f:
                return [line.split("\t")[:3] for line in f if line.strip()]
        with open(output[0], "w") as out:
            out.write("condition\tcaller\tn_replicates\tmin_replicates\tpooled_peaks\tconsensus_peaks\tmedian_width\n")
            for caller in ["seacr", "macs3"]:
                for cond in CONSENSUS_CONDITIONS:
                    pooled = {tuple(x) for x in intervals(pooled_peaks(caller, cond))}
                    cons = intervals(f"peaks/consensus/{caller}/{cond}.consensus.bed")
                    widths = [int(e) - int(s) for _, s, e in cons]
                    median = statistics.median(widths) if widths else "NA"
                    out.write(f"{cond}\t{caller}\t{len(CONDITION_SAMPLES[cond])}\t{consensus_threshold(cond)}\t"
                              f"{len(pooled)}\t{len(cons)}\t{median}\n")


