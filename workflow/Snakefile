        """
        if [ {params.has_igg} == True ]; then
           macs3 callpeak -t {input.exp} -c {input.con} -f BAM --nomodel --extsize 147 -g {config[genome_size]} -n "{params.prefix}" --outdir {params.dir} {params.mode} --keep-dup all -B --SPMR -q {config[macs3_qvalue_with_control]} 2> {log} || true
        else
           macs3 callpeak -t {input.exp} -f BAM --nomodel --extsize 147 -g {config[genome_size]} -n "{params.prefix}" --outdir {params.dir} {params.mode} --keep-dup all -B --SPMR -q {config[macs3_qvalue_no_control]} --nolambda 2> {log} || true
        fi
        if [ ! -f {output.npeaks} ]; then
            touch {output.npeaks}
            touch {output.peaks}
        fi
        """

