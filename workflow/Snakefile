rule make_peak_heatmap:
    input:
        bw="alignments/{sample}_raw.bw",
        peaks="peaks/seacr/{sample}.peaks.stringent.bed",
    output:
        peaks=temp("peaks/seacr/{sample}.peaks.summitRegion.bed"),
        mat=temp("peaks/seacr/{sample}.mat.gz"),
        heatmap="stats/seacr/{sample}.heatmap.png",
    wildcard_constraints:
        sample="|".join(EXPERIMENT) if EXPERIMENT else "NO_EXPERIMENT_SAMPLES"
    log:
        "logs/make_peak_heatmap/{sample}.log",
    conda:
        "envs/deeptools.yaml"
    threads: 2
    shell:
        """
        if [ -s {input.peaks} ]; then
            awk '{{split($6, summit, ":"); split(summit[2], region, "-"); print summit[1]"\t"region[1]"\t"region[2]}}' {input.peaks} > {output.peaks}

            computeMatrix reference-point \
              -S {input.bw} \
              -R {output.peaks} \
              --skipZeros \
              -o {output.mat} -p {threads} -a {config[heatmap_window]} -b {config[heatmap_window]} \
              --referencePoint center

            plotHeatmap -m {output.mat} -out {output.heatmap} --sortUsing sum \
            --startLabel "Peak Start" --endLabel "Peak End" \
            --xAxisLabel "" \
            --regionsLabel "Peaks" --samplesLabel "{wildcards.sample}"
        else
            touch {output.peaks}
            touch {output.mat}
            touch {output.heatmap}
        fi
        """

if config["gtf_file"]:
    rule extract_tss:
        input:
            gtf=config["gtf_file"],
            fai=config["reference_fai"],
        output:
            tss="annotations/tss.bed",
        log:
            "logs/extract_tss/job.log",
        conda:
            "envs/bedtools.yaml"
        shell:
            """
            mkdir -p annotations

            # Handle both gzipped and regular GTF files
            if [[ {input.gtf} == *.gz ]]; then
                zcat {input.gtf} | awk '$3=="gene" && $7=="+" && $0~/gene_(bio)?type "protein_coding"/ {{print $1"\\t"($4-1)"\\t"$4"\\t"$10"\\t"$6"\\t"$7}} $3=="gene" && $7=="-" && $0~/gene_(bio)?type "protein_coding"/ {{print $1"\\t"($5-1)"\\t"$5"\\t"$10"\\t"$6"\\t"$7}}' | sed 's/[";]//g' > {output.tss}
            else
                cat {input.gtf} | awk '$3=="gene" && $7=="+" && $0~/gene_(bio)?type "protein_coding"/ {{print $1"\\t"($4-1)"\\t"$4"\\t"$10"\\t"$6"\\t"$7}} $3=="gene" && $7=="-" && $0~/gene_(bio)?type "protein_coding"/ {{print $1"\\t"($5-1)"\\t"$5"\\t"$10"\\t"$6"\\t"$7}}' | sed 's/[";]//g' > {output.tss}
            fi

            if [ ! -s {output.tss} ]; then
                echo "ERROR: no protein_coding genes found in {input.gtf} (expected gene_type or gene_biotype attribute)" >&2
                exit 1
            fi
            if ! cut -f1 {output.tss} | sort -u | grep -xFf <(cut -f1 {input.fai}) > /dev/null; then
                echo "ERROR: chromosome names in {input.gtf} do not match {input.fai} (e.g. '1' vs 'chr1'); use a GTF with matching names" >&2
                exit 1
            fi
            """


# ---------------------------------------------------------------------------
# Enrichment over region sets: signal profile, reads in regions, peak overlap
# ---------------------------------------------------------------------------
OKABE_ITO = ['#E69F00', '#56B4E9', '#009E73', '#F0E442', '#0072B2', '#D55E00', '#CC79A7', '#000000']

rule prepare_regions:
    input:
        bed=lambda w: REGION_FILES[w.region],
        chroms=config["chromosome_file"],
        blacklist=config["blacklist"],
    output:
        points="annotations/regions/{region}.points.bed",
        merged="annotations/regions/{region}.merged.bed",
    log:
        "logs/prepare_regions/{region}.log",
    conda:
        "envs/bedtools.yaml"
    shell:
        """
        tmp=$(mktemp -d annotations/regions/{wildcards.region}.XXXXXX)
        trap 'rm -rf "$tmp"' EXIT
        # regions on the analysed chromosomes (BED, BED.gz or narrowPeak)
        gzip -dcf {input.bed} | awk -F'\\t' -v OFS='\\t' 'NR == FNR {{keep[$1] = 1; next}}
            /^(#|track|browser)/ {{next}} ($1 in keep) && NF >= 3' {input.chroms} - > $tmp/regions.bed
        if [ ! -s $tmp/regions.bed ]; then
            echo "ERROR: no regions of {input.bed} on the chromosomes in {input.chroms}" >&2
            exit 1
        fi
        # reference point: narrowPeak summit, single-base sites as given, otherwise the centre
        awk -F'\\t' -v OFS='\\t' '{{
            if (NF == 10 && $10 ~ /^[0-9]+$/) p = $2 + $10
            else if ($3 - $2 == 1) p = $2
            else p = int(($2 + $3) / 2)
            strand = (NF >= 6 && ($6 == "+" || $6 == "-")) ? $6 : "."
            print $1, p, p + 1, (NF >= 4 ? $4 : "region" NR), 0, strand}}' $tmp/regions.bed \\
            | sort -k1,1 -k2,2n > {output.points}
        # merged regions outside the blacklist, for reads-in-regions and peak overlap
        cut -f 1-3 $tmp/regions.bed | sort -k1,1 -k2,2n | bedtools merge \\
            | bedtools subtract -a - -b {input.blacklist} > {output.merged}
        """

rule region_profile:
    input:
        points="annotations/regions/{region}.points.bed",
        bw=expand("bigwig/{sample}.bw", sample=SAMPLES),
    output:
        matrix="stats/enrichment/{region}_matrix.gz",
        score="stats/enrichment/{region}_profile_score.txt",
        profile="stats/enrichment/{region}_profile.pdf",
        heatmap="stats/enrichment/{region}_heatmap.png",
    log:
        "logs/region_profile/{region}.log",
    conda:
        "envs/deeptools.yaml"
    threads: 4
    params:
        labels=" ".join(SAMPLES),
        colors=" ".join(f"'{OKABE_ITO[i % len(OKABE_ITO)]}'" for i in range(len(SAMPLES))),
        ylabel="Mean signal per 10,000 spike-in fragments" if SPIKEIN_NORM else "Mean CPM",
    shell:
        """
        computeMatrix reference-point -S {input.bw} -R {input.points} --samplesLabel {params.labels} \\
            --referencePoint center -a 2000 -b 2000 --binSize 50 --skipZeros --missingDataAsZero \\
            -o {output.matrix} -p {threads} 2> {log}
        plotProfile -m {output.matrix} -out {output.profile} --averageType mean --perGroup \\
            --colors {params.colors} --refPointLabel "{wildcards.region}" \\
            --plotTitle "{wildcards.region}" --yAxisLabel "{params.ylabel}" 2>> {log}
        plotHeatmap -m {output.matrix} -out {output.heatmap} --colorMap viridis \\
            --refPointLabel "{wildcards.region}" --regionsLabel "{wildcards.region}" 2>> {log}
        python3 {workflow.basedir}/scripts/calculate_profile_enrichment.py {output.matrix} {output.score} >> {log} 2>&1
        """

rule region_reads:
    input:
        merged="annotations/regions/{region}.merged.bed",
        fragments=expand("bedalignments/{sample}.fragments.bed", sample=SAMPLES),
        fai=config["reference_fai"],
        chroms=config["chromosome_file"],
        blacklist=config["blacklist"],
    output:
        "stats/enrichment/{region}_reads.txt",
    log:
        "logs/region_reads/{region}.log",
    conda:
        "envs/bedtools.yaml"
    params:
        names=SAMPLES,
    shell:
        """
        # analysable genome: listed chromosomes minus blacklist
        genome_bp=$(awk 'NR == FNR {{keep[$1] = 1; next}} ($1 in keep) {{s += $2}} END {{print s}}' {input.chroms} {input.fai})
        black_bp=$(gzip -dcf {input.blacklist} | awk 'NR == FNR {{keep[$1] = 1; next}} ($1 in keep)' {input.chroms} - \\
            | cut -f 1-3 | sort -k1,1 -k2,2n | bedtools merge | awk '{{s += $3 - $2}} END {{print s + 0}}')
        region_bp=$(awk '{{s += $3 - $2}} END {{print s + 0}}' {input.merged})
        names=({params.names})
        frags=({input.fragments})
        printf "sample\\tfragments\\tfragments_in_regions\\tregion_bp\\tgenome_bp\\n" > {output}
        for i in "${{!frags[@]}}"; do
            n=$(wc -l < "${{frags[$i]}}")
            k=$(bedtools intersect -u -a "${{frags[$i]}}" -b {input.merged} | wc -l)
            printf "%s\\t%s\\t%s\\t%s\\t%s\\n" "${{names[$i]}}" $n $k $region_bp $((genome_bp - black_bp)) >> {output}
        done
        """

REGION_PEAK_SETS = ([f"{s}|seacr|peaks/seacr/{s}.peaks.stringent.bed" for s in EXPERIMENT]
                    + [f"{s}|macs3|peaks/macs3/{s}{MACS_SUFFIX}" for s in EXPERIMENT]
                    + [f"consensus:{c}|{caller}|peaks/consensus/{caller}/{c}.consensus.bed"
                       for caller in ["seacr", "macs3"] for c in CONSENSUS_CONDITIONS])

rule region_peaks:
    input:
        merged="annotations/regions/{region}.merged.bed",
        peaks=[e.split("|")[2] for e in REGION_PEAK_SETS],
        fai=config["reference_fai"],
        chroms=config["chromosome_file"],
        blacklist=config["blacklist"],
    output:
        "stats/enrichment/{region}_peaks.txt",
    log:
        "logs/region_peaks/{region}.log",
    conda:
        "envs/bedtools.yaml"
    params:
        sets=" ".join(f"'{e}'" for e in REGION_PEAK_SETS),  # quoted: entries contain '|'
        shuffles=10,
    shell:
        """
        # observed overlap vs. the mean of shuffled peak sets (same chromosomes, outside the blacklist)
        tmp=$(mktemp -d stats/enrichment/{wildcards.region}.XXXXXX)
        trap 'rm -rf "$tmp"' EXIT
        awk -v OFS='\\t' 'NR == FNR {{keep[$1] = 1; next}} ($1 in keep) {{print $1, $2}}' {input.chroms} {input.fai} > $tmp/genome.txt
        printf "set\\tcaller\\tpeaks\\tpeaks_in_regions\\texpected_in_regions\\n" > {output}
        for entry in {params.sets}; do
            IFS='|' read -r label caller path <<< "$entry"
            cut -f 1-3 "$path" > $tmp/peaks.bed
            n=$(wc -l < $tmp/peaks.bed)
            if [ "$n" -eq 0 ]; then
                printf "%s\\t%s\\t0\\tNA\\tNA\\n" "$label" "$caller" >> {output}
                continue
            fi
            obs=$(bedtools intersect -u -a $tmp/peaks.bed -b {input.merged} | wc -l)
            exp=0
            for seed in $(seq 1 {params.shuffles}); do
                # very wide peaks may not fit outside the blacklist: report NA instead of failing
                if ! e=$(bedtools shuffle -i $tmp/peaks.bed -g $tmp/genome.txt -excl {input.blacklist} -chrom \\
                        -seed $seed -maxTries 10000 | bedtools intersect -u -a - -b {input.merged} | wc -l); then
                    exp=NA
                    break
                fi
                exp=$((exp + e))
            done
            if [ "$exp" = NA ]; then
                printf "%s\\t%s\\t%s\\t%s\\tNA\\n" "$label" "$caller" $n $obs >> {output}
                continue
            fi
            printf "%s\\t%s\\t%s\\t%s\\t%s\\n" "$label" "$caller" $n $obs \\
                $(awk -v e=$exp -v k={params.shuffles} 'BEGIN {{printf "%.2f", e / k}}') >> {output}
        done 2> {log}
        """

rule region_enrichment:
    input:
        scores=expand("stats/enrichment/{region}_profile_score.txt", region=REGIONS),
        reads=expand("stats/enrichment/{region}_reads.txt", region=REGIONS),
        peaks=expand("stats/enrichment/{region}_peaks.txt", region=REGIONS),
    output:
        "stats/region_enrichment.txt",
    log:
        "logs/region_enrichment/job.log",
    run:
        # one row per region set and sample (plus consensus peak sets); *_vs_igg = sample / matched IgG
        rows = []
        for region in REGIONS:
            score = pd.read_csv(f"stats/enrichment/{region}_profile_score.txt", sep="\t")
            score = dict(zip(score["sample_id"], score["profile_score"]))
            reads = pd.read_csv(f"stats/enrichment/{region}_reads.txt", sep="\t").set_index("sample")
            peaks = pd.read_csv(f"stats/enrichment/{region}_peaks.txt", sep="\t")
            reads["pct"] = 100 * reads["fragments_in_regions"] / reads["fragments"].where(reads["fragments"] > 0)
            reads["genome_pct"] = 100 * reads["region_bp"] / reads["genome_bp"]
            reads["fold"] = reads["pct"] / reads["genome_pct"]
            def peak_cols(label):
                out = {}
                for caller in ["seacr", "macs3"]:
                    hit = peaks[(peaks["set"] == label) & (peaks["caller"] == caller)]
                    if hit.empty or pd.isna(hit["peaks_in_regions"].iloc[0]):
                        out.update({f"{caller}_peaks_in_regions_pct": None, f"{caller}_peaks_fold": None})
                        continue
                    n, obs, exp = (float(hit[c].iloc[0]) for c in ["peaks", "peaks_in_regions", "expected_in_regions"])
                    out.update({f"{caller}_peaks_in_regions_pct": round(100 * obs / n, 2),
                                f"{caller}_peaks_fold": round(obs / exp, 2) if exp > 0 else None})
                return out
            def ratio(a, b):
                return round(a / b, 2) if a is not None and b not in (None, 0) and pd.notna(a) and pd.notna(b) else None
            for sample in SAMPLES:
                igg = matched_control(sample)
                prof = score.get(sample)
                rows.append({"region": region, "sample": sample, "condition": samplesheet.loc[sample, "condition"],
                             "matched_igg": igg or "",
                             "profile_score": prof,
                             "profile_score_vs_igg": ratio(prof, score.get(igg)) if igg else None,
                             "reads_in_regions_pct": round(reads.loc[sample, "pct"], 2),
                             "region_genome_pct": round(reads.loc[sample, "genome_pct"], 3),
                             "reads_fold": round(reads.loc[sample, "fold"], 2),
                             "reads_fold_vs_igg": ratio(reads.loc[sample, "fold"], reads.loc[igg, "fold"]) if igg else None,
                             **peak_cols(sample)})
            for condition in CONSENSUS_CONDITIONS:
                rows.append({"region": region, "sample": "consensus", "condition": condition,
                             **peak_cols(f"consensus:{condition}")})
        columns = ["region", "sample", "condition", "matched_igg", "profile_score", "profile_score_vs_igg",
                   "reads_in_regions_pct", "region_genome_pct", "reads_fold", "reads_fold_vs_igg",
                   "seacr_peaks_in_regions_pct", "seacr_peaks_fold", "macs3_peaks_in_regions_pct", "macs3_peaks_fold"]
        pd.DataFrame(rows, columns=columns).to_csv(output[0], sep="\t", index=False, na_rep="NA")

rule generate_html_report:
    input:
        stats="stats/stats.txt",
        consolidated="stats/peaks_consolidated.txt",
        seacr_num="stats/seacr/peaks_num.txt",
        seacr_reprod="stats/seacr/peaks_reproducibility.txt",
        seacr_frip="stats/seacr/peaks_frip.txt",
        seacr_width="stats/seacr/peaks_width_stats.txt",
        seacr_gc="stats/seacr/peaks_gc_content.txt",
        macs3_num="stats/macs3/peaks_num.txt",
        macs3_reprod="stats/macs3/peaks_reproducibility.txt",
        macs3_frip="stats/macs3/peaks_frip.txt",
        macs3_width="stats/macs3/peaks_width_stats.txt",
        macs3_gc="stats/macs3/peaks_gc_content.txt",
        seacr_peaks=expand("peaks/seacr/{sample}.peaks.stringent.bed", sample=EXPERIMENT),
        macs3_peaks=expand(f"peaks/macs3/{{sample}}{MACS_SUFFIX}", sample=EXPERIMENT),
        fragments=expand("alignments/{sample}.fraglengths.txt", sample=PE_SAMPLES),
        coverage_bins=expand("bedalignments/{sample}.bin.bed", sample=SAMPLES),
        regions="stats/region_enrichment.txt",
        consensus="stats/consensus_peaks.txt",
        samples="stats/samples.tsv",
    output:
        html_report="reports/cutntag_analysis_report.html",
    log:
        "logs/generate_html_report/job.log",
    conda:
        "envs/R.yaml"
    params:
        outdir=config["outdir"],
        snakefile_dir=workflow.basedir,
        macs3_suffix=MACS_SUFFIX,
    script:
        "scripts/render_html_report.R"

# Rule ordering to prevent conflicts when both PE and SE samples are present
ruleorder: check_quality_pe > check_quality_se > check_quality_bam
ruleorder: trim_adapters_pe > trim_adapters_se
ruleorder: align_reads_pe > align_reads_se
ruleorder: convert_to_binary > import_bam

rule bedgraph_to_tdf:
